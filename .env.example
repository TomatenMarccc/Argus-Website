# --- Admin-Bereich (/admin/news) ------------------------------------------
# Ohne diese beiden Werte ist der Admin-Bereich deaktiviert und meldet das
# auch klar, statt einen unsicheren Ersatz-Login anzubieten.
# ADMIN_PASSWORD: frei wählbares, langes Passwort.
# ADMIN_SESSION_SECRET: Zufallswert, z. B. `openssl rand -base64 48`.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Supabase (News-Datenbank + Bild-Storage) ------------------------------
# Ohne diese Werte liest die Website News aus content/news/*.json (read-only).
# Mit diesen Werten werden News in Supabase gespeichert und im Admin editierbar.
# Der Service-Role-Key wird ausschliesslich serverseitig verwendet.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=news

# --- Deployment ------------------------------------------------------------
# Kanonische URL fuer Metadaten, Sitemap und Open Graph.
NEXT_PUBLIC_SITE_URL=
